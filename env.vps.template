# GaiaLog VPS template
# Dedicated single-writer process for queue mutation, UTXO maintenance,
# signing, ARC broadcasting, and overlay submission.

NODE_ENV=production
GAIALOG_WORKER_PROCESS=1
GAIALOG_SINGLE_WRITER_MODE=run-workers
GAIALOG_MUTATOR_ROLE=primary
GAIALOG_NO_DB=false
BSV_ENABLE_UTXO_DB_LOCKS=true
# Heap guard: 0.98 allows more headroom before pausing (avoids HEAP_PRESSURE_BACKOFF)
BSV_HEAP_GUARD_HIGH_WATERMARK=0.98
BSV_HEAP_GUARD_PAUSE_MS=10000
BSV_UTXO_MAINTAINER_DISABLED=false

# Spend-source rollout
# Parallel cutover across W1/W2/W3. Keep queue gating on legacy first, then
# flip GAIALOG_QUEUE_GATE_SOURCE=overlay once parity and submit/admit SLOs are green.
BSV_SPEND_SOURCE_MODE=overlay
BSV_SPEND_SOURCE_SHADOW_READS=true
BSV_SPEND_SOURCE_LEGACY_FALLBACK_ENABLED=false
BSV_OVERLAY_CONFIRMED_ONLY=true
BSV_OVERLAY_TOPIC_PREFIX=TREASURY
BSV_OVERLAY_TOPIC_VERSION=v1
BSV_OVERLAY_AUTH_MODE=none
BSV_OVERLAY_FORCE_LEGACY_WALLETS=
BSV_OVERLAY_WALLET_FAILURE_THRESHOLD=3
BSV_OVERLAY_WALLET_FALLBACK_COOLDOWN_MS=300000
GAIALOG_QUEUE_GATE_SOURCE=overlay

# Overlay HTTP client
# These URLs point at the private loopback overlay service on the VPS.
# Mutual-auth headers are negotiated dynamically via BRC-104/Authrite; only
# x-bsv-* or Authorization headers are valid in the JSON header overrides below.
BSV_OVERLAY_PROVIDER_ID=donations-lookup
BSV_OVERLAY_LOOKUP_URL=http://127.0.0.1:3100/lookup
BSV_OVERLAY_SUBMIT_URL=http://127.0.0.1:3100/submit
BSV_OVERLAY_HEADERS_JSON={"x-bsv-originator":"gaialog-worker"}
BSV_OVERLAY_LOOKUP_HEADERS_JSON={"x-bsv-overlay-route":"lookup"}
BSV_OVERLAY_SUBMIT_HEADERS_JSON={"x-bsv-overlay-route":"submit"}
# Use distinct client/server identities in production. Reusing one WIF for both
# sides is acceptable only for short-lived smoke testing.
BSV_OVERLAY_CLIENT_IDENTITY_WIF=replace_me
BSV_OVERLAY_TIMEOUT_MS=15000
BSV_OVERLAY_MAX_RETRIES=3
BSV_OVERLAY_COUNT_FALLBACK_LIMIT=0
# Keep false globally for now; split outputs should still require all-host
# acknowledgement in the split/admission path as that lands.
BSV_OVERLAY_REQUIRE_ALL_HOST_ACKS=false

# Overlay server (PM2 loopback-only process on the VPS)
GAIALOG_OVERLAY_BIND_HOST=127.0.0.1
GAIALOG_OVERLAY_PORT=3100
GAIALOG_OVERLAY_HOST_ID=vps-1
GAIALOG_OVERLAY_SERVER_IDENTITY_WIF=replace_me
GAIALOG_OVERLAY_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# GAIALOG_OVERLAY_ALLOWED_IDENTITY_KEYS=
GAIALOG_OVERLAY_RATE_LIMIT_WINDOW_MS=60000
GAIALOG_OVERLAY_RATE_LIMIT_MAX=20000
GAIALOG_OVERLAY_JSON_LIMIT_BYTES=10485760
GAIALOG_OVERLAY_AUDIT_HMAC_SECRET=replace_me_with_a_long_random_string

# Explorer read-path egress tuning
EXPLORER_LOCATION_SAMPLE_LIMIT=400
EXPLORER_LOCATION_CACHE_TTL_MS=60000
EXPLORER_LOCATION_CACHE_MAX_ENTRIES=256
EXPLORER_SEARCH_CACHE_TTL_MS=15000
EXPLORER_SEARCH_CACHE_MAX_ENTRIES=128
EXPLORER_STATS_CACHE_TTL_MS=30000

# Explorer overlay — use overlay for both read and write when overlay_explorer_readings
# exists (migration 0011). Do NOT use dual/legacy if explorer_readings table is absent.
EXPLORER_WRITE_MODE=overlay
EXPLORER_READ_SOURCE=overlay

# Shared Postgres / Supabase (use Shared Pooler for IPv4 compatibility)
# From Supabase: Settings → Database → Connection string → Shared Pooler
PGHOST=aws-1-eu-west-1.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.your_project_ref
PGPASSWORD=replace_me
PGDATABASE=postgres
PGPOOL_MAX=3
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# BSV signing / broadcasting
BSV_NETWORK=mainnet
# ─── Single unified wallet (recommended) ─────────────────────────────────────
# BSV_WALLET_1_PRIVATE_KEY alone is the supported treasury mode: one key signs,
# one address holds every pool and reserve output. Keep W2/W3 only while
# migrating an existing three-wallet deployment, and drain them first:
#   npx tsx scripts/migrate-to-single-wallet.ts --source=bitails   # dry-run
#   npx tsx scripts/migrate-to-single-wallet.ts --apply --yes      # broadcast
# Remove the W2/W3 keys and their _ADDRESS entries only once that run reports
# zero live rows on every source wallet. Configured keys keep the round-robin alive.
BSV_WALLET_1_PRIVATE_KEY=replace_me
# Migration only — delete these two lines once the sweep above is verified.
BSV_WALLET_2_PRIVATE_KEY=replace_me
BSV_WALLET_3_PRIVATE_KEY=replace_me
# Legacy ARC chain (fallback only now — see the Broadcaster block below)
BSV_API_ENDPOINT=https://arc.taal.com
BSV_GORILLAPOOL_ARC_ENDPOINT=https://arc.gorillapool.io
BSV_ARC_API_KEY=replace_me
# BSV_GORILLAPOOL_API_KEY=

# ─── BSV Broadcaster (Arcade) — primary broadcast path ───────────────────────
# Every broadcast submits BRC-30 EF bytes here first; the legacy ARC ladder above
# is reached only when no Broadcaster host can be contacted. A terminal rejection
# is never retried elsewhere. Set BSV_BROADCASTER_ENABLED=false only to roll back
# to ARC-only broadcasting.
BSV_BROADCASTER_ENABLED=true
BSV_BROADCASTER_HOSTS=https://arcade-eu-1.bsvblockchain.tech,https://arcade-us-1.bsvblockchain.tech,https://arcade.gorillapool.io
# Stable random hex token: `openssl rand -hex 32`. Scopes the SSE `GET /events`
# resume stream and is persisted per arc_broadcast_status row, so a restart
# resumes the same channel. Empty falls back to BSV_BROADCASTER_TOKEN_SEED, then
# BSV_PRIVATE_KEY, then BSV_WALLET_1_PRIVATE_KEY.
BSV_BROADCASTER_CALLBACK_TOKEN=
# Opt out of the SSE subscriber and reconciler pair. Broadcasting still uses the
# Broadcaster unless BSV_BROADCASTER_ENABLED is also false.
BSV_BROADCASTER_DISABLED=false
# WhatsOnChain as the last-resort legacy fallback. Keep false: rate limited and
# no lifecycle tracking. TAAL → GorillaPool → WoC, with this flag opting WoC in.
BSV_BROADCAST_WOC_FALLBACK=false

# ─── SPV / Chaintracks header verification ───────────────────────────────────
# Headers count as spvVerified only when each hash meets its target AND links to
# its neighbour, so the source must be one whose consistency you trust.
BSV_CHAINTRACKS_URL=https://arcade-eu-1.bsvblockchain.tech/chaintracks
# Self-hosted Chaintracks on this VPS serves the same API at its root. Loopback
# and private-range hosts are treated as operator-controlled — the stronger trust
# case. Prefer this once the local process is healthy; use the tunnel above only
# while it is being provisioned.
# BSV_CHAINTRACKS_URL=http://127.0.0.1:3011

# ─── Confirmation & UTXO discovery (off WoC's rate limits) ───────────────────
# WoC allows ~3 req/s, which cannot track this write volume. Bitails is primary
# for confirmations and UTXO reads. WoC address lookups are refused by policy, so
# UTXO discovery comes from the overlay, Bitails, or an operator-controlled indexer.
BSV_CONFIRMATION_PROVIDER=bitails
BSV_CONFIRMATION_WOC_FALLBACK=false
BSV_UTXO_PROVIDER=bitails
BSV_BITAILS_API_BASE=https://api.bitails.io
# BSV_SPEND_SOURCE_LEGACY_FALLBACK_ENABLED=false is set above, in the spend-source
# rollout block: no silent fallback to the legacy UTXO provider, because in overlay
# mode it hides an overlay outage and can spend from a second, unaudited inventory.

# ─── Proactive UTXO dust consolidation ───────────────────────────────────────
# Sweep one batch of confirmed sub-split-floor dust once a wallet holds this many,
# before starvation forces a recovery sweep. Keeps the pool shallow and ancestor
# chains short. 0 disables the proactive trigger (reactive sweeps still run).
BSV_AUTO_CONSOLIDATE_PROACTIVE_DUST_COUNT=250

# Throughput / queue defaults
BSV_BYPASS_QUEUE=false
BSV_PREFER_CONFIRMED_UTXOS=true
# Legacy compatibility until PR6 replaces fixed auto-sizing with admission-driven
# deficit-fill targets and live fee telemetry.
BSV_EXPECTED_TX_PER_DAY=2000000
BSV_UTXO_SPLIT_OUTPUT_SATS=2000
BSV_UTXO_LOCK_TTL_MS=600000
# Propagation grace for newly admitted change/split outputs (milliseconds).
# Gives the parent transaction time to reach every ARC relay before any child
# tx can spend its change. Eliminates the dominant ARC 460 "parent transaction
# not found" pattern under high concurrency. Also used as the default cooldown
# when a broadcast failure releases a UTXO. Default 2500. Set to 0 to disable.
BSV_PROPAGATION_GRACE_MS=2500
# Reserved for the PR6 admission-driven splitter. Safe to set now; current code
# ignores these until the new splitter policy lands.
GAIALOG_UTXO_TARGET_BUFFER_MINUTES=5
GAIALOG_UTXO_HYSTERESIS_PCT=0.15
GAIALOG_SPLIT_PER_TX_CAP=256
GAIALOG_SPLIT_P95_HEADROOM=1.30

# Admin / operations
ADMIN_PASSWORD=replace_me
ADMIN_SECRET=replace_me_with_a_long_random_string

# Optional production-only guard for internal/debug/test routes exposed by the
# Next.js app. Access requires header:
#   x-gaialog-internal-secret: <GAIALOG_INTERNAL_API_SECRET>
# GAIALOG_INTERNAL_API_SECRET=replace_me_with_a_long_random_string

# Optional secret for /api/auth/admin-reset if that route is intentionally used.
# ADMIN_RESET_SECRET=replace_me_with_a_long_random_string

# Rollout gate — gate_d enables all providers
GAIALOG_ROLLOUT_GATE=gate_d

# Provider keys
WAQI_API_KEY=replace_me
WAQI_RPS=15
WAQI_PER_DAY=1296000
WAQI_WORKER_INTERVAL_MS=60000
WAQI_STATION_PAGE_SIZE=1000
WAQI_STATION_CONCURRENCY=60
WAQI_TILES_PER_CYCLE=576
# Movebank: MOVEBANK_USERNAME + MOVEBANK_PASSWORD, or MOVEBANK_API_KEY (api-token or user:pass)
MOVEBANK_USERNAME=
MOVEBANK_PASSWORD=
MOVEBANK_API_KEY=
WEATHERAPI_KEY=replace_me
OWM_API_KEY=replace_me
OWM_API_KEY_2=
# Optional comma-separated alternative to OWM_API_KEY / OWM_API_KEY_2
OWM_API_KEYS=
USGS_API_KEY=replace_me

# Reverse geocoding (converts lat/lon to place names for explorer search)
# At least one key recommended for production; Nominatim fallback is rate-limited.
# Priority: OpenCage > LocationIQ > Nominatim (free, 1 req/s)
OPENCAGE_API_KEY=
LOCATIONIQ_API_KEY=
# GEOCODE_ENABLED=true
# GEOCODE_MAX_DAILY_CALLS=10000
